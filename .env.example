# Database configuration (PostgreSQL is required)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Environment setting (production or development)
NODE_ENV=production

# Server listening port
PORT=5001

# Secret key for Express sessions (replace with a long random string)
SESSION_SECRET=your_random_secure_secret_key_here

# InstantAlerts SMS credentials for OTP
INSTANTALERTS_API_KEY=your_instantalerts_api_key_here

# Razorpay credentials for payment gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Admin credentials
SUPER_ADMIN_PASSWORD=your_super_admin_password_here
SUB_ADMIN_PASSWORD=your_sub_admin_password_here

# Optional: API Base URL. Leave blank for relative paths (recommended for unified web server)
VITE_API_BASE_URL=
